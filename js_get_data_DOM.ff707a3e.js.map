'use strict';
// #region Calculate the average and total population
// from the population elements on the page
var populations = document.querySelectorAll('.population');
var numbers = Array.from(populations).map(function(population) {
    return parseInt(population.textContent.replace(/,/g, ''));
}).filter(function(num) {
    return !Number.isNaN(num);
});
var averagePopulation = numbers.reduce(function(acc, curr) {
    return acc + curr;
}, 0) / numbers.length;
var totalPopulation = numbers.reduce(function(acc, curr) {
    return acc + curr;
}, 0);
var averagePopulationElement = document.querySelector('.average-population');
averagePopulationElement.textContent = averagePopulation.toLocaleString();
var totalPopulationElement = document.querySelector('.total-population');
totalPopulationElement.textContent = totalPopulation.toLocaleString(); // #endregion

